naxes[0,1].scatter(train_df['prior_day_kwh'], train_df['kwh'], alpha=0.1, s=5)\naxes[0,1].set_xlabel('prior_day_kwh')\naxes[0,1].set_ylabel('kwh')\naxes[0,1].set_title('kWh vs Prior Day kWh')\n\n# kWh by heating type\ntrain_df.boxplot(column='kwh', by='heating_type', ax=axes[1,0])\naxes[1,0].set_title('kWh by Heating Type')\naxes[1,0].set_xlabel('heating_type')\n\n# kWh by has_ev\ntrain_df.boxplot(column='kwh', by='has_ev', ax=axes[1,1])\naxes[1,1].set_title('kWh by EV Ownership')\naxes[1,1].set_xlabel('has_ev')\n\nplt.tight_layout()\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-06T16:44:25.970778Z","iopub.execute_input":"2026-07-06T16:44:25.971057Z","iopub.status.idle":"2026-07-06T16:44:27.026384Z","shell.execute_reply.started":"2026-07-06T16:44:25.97103Z","shell.execute_reply":"2026-07-06T16:44:27.025088Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## PREPARING DATA","metadata":{}},{"cell_type":"code","source":"# === CELL A: Feature Engineering ===\n# One-hot encode heating_type on BOTH dataframes\ntrain_df = pd.get_dummies(train_df, columns=['heating_type'], prefix='heat')\ntest_df  = pd.get_dummies(test_df,  columns=['heating_type'], prefix='heat')\n\n# Log-transform the target\ntrain_df['kwh_log'] = np.log1p(train_df['kwh'])\n\n# Convert date to datetime\ntrain_df['date'] = pd.to_datetime(train_df['date'])\ntest_df['date']  = pd.to_datetime(test_df['date'])\n\nprint(\"train_df shape after encoding:\", train_df.shape)\nprint(\"test_df shape after encoding: \", test_df.shape)\nprint(\"New columns:\", [c for c in train_df.columns if c.startswith('heat_')])\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-06T16:44:27.027907Z","iopub.execute_input":"2026-07-06T16:44:27.02825Z","iopub.status.idle":"2026-07-06T16:44:27.084315Z","shell.execute_reply.started":"2026-07-06T16:44:27.028222Z","shell.execute_reply":"2026-07-06T16:44:27.083224Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# === CELL B: Train/Val Split ===\n\n# Sort dates and use the last 14 days as validation\ntrain_dates = sorted(train_df['date'].unique())\nsplit_date  = train_dates[-14]\n\ntrn = train_df[train_df['date'] < split_date].copy()\nval = train_df[train_df['date'] >= split_date].copy()\n\nprint(f\"Train rows: {len(trn)}  ({trn['date'].min().date()} → {trn['date'].max().date()})\")\nprint(f\"Val rows:   {len(val)}  ({val['date'].min().date()} → {val['date'].max().date()})\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-06T16:44:27.085514Z","iopub.execute_input":"2026-07-06T16:44:27.08589Z","iopub.status.idle":"2026-07-06T16:44:27.11792Z","shell.execute_reply.started":"2026-07-06T16:44:27.085862Z","shell.execute_reply":"2026-07-06T16:44:27.116902Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# === CELL C: Feature List and Matrices ===\n\n# Columns to exclude from features\nEXCLUDE = ['row_id', 'household_id', 'date', 'kwh', 'kwh_log']\n\nfeature_cols = [c for c in train_df.columns if c not in EXCLUDE]\n\nprint(f\"Number of features: {len(feature_cols)}\")\nprint(\"Features:\", feature_cols)\n\n# Build matrices\nX_train = trn[feature_cols]\ny_train = trn['kwh_log']\nX_val   = val[feature_cols]\ny_val   = val['kwh_log']\nX_test  = test_df[feature_cols]\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-06T16:44:27.119278Z","iopub.execute_input":"2026-07-06T16:44:27.119747Z","iopub.status.idle":"2026-07-06T16:44:27.132993Z","shell.execute_reply.started":"2026-07-06T16:44:27.119625Z","shell.execute_reply":"2026-07-06T16:44:27.131637Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# === CELL D: Train XGBoost ===\n\nmodel = xgb.XGBRegressor(\n    n_estimators=2000,           # high ceiling; early stopping will cut this short\n    learning_rate=0.05,\n    max_depth=4,\n    reg_alpha=1.0,\n    reg_lambda=2.0,\n    early_stopping_rounds=25,    # ← must be in the constructor, not .fit()\n    random_state=42,\n    n_jobs=-1\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    verbose=50\n)\n\nprint(f\"\\nBest iteration: {model.best_iteration}\")\nprint(f\"Best val score: {model.best_score:.4f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-06T17:08:50.732725Z","iopub.execute_input":"2026-07-06T17:08:50.733884Z","iopub.status.idle":"2026-07-06T17:08:59.835423Z","shell.execute_reply.started":"2026-07-06T17:08:50.733829Z","shell.execute_reply":"2026-07-06T17:08:59.834725Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# === CELL E: Evaluate ===\n\n# Predict on validation (in log space), convert back, clip at 0\nval_pred_log = model.predict(X_val)\nval_pred     = np.clip(np.expm1(val_pred_log), 0, None)\n\n# RMSLE\nrmsle = np.sqrt(mean_squared_error(np.log1p(val['kwh']), np.log1p(val_pred)))\nrmse  = np.sqrt(mean_squared_error(val['kwh'], val_pred))\n\n# Baseline (always predict median)\nbaseline_rmsle = np.sqrt(mean_squared_error(\n    np.log1p(val['kwh']),\n    np.log1p(np.full(len(val), train_df['kwh'].median()))\n))\n\nprint(f\"Validation RMSLE:        {rmsle:.4f}\")\nprint(f\"Validation RMSE (kWh):   {rmse:.2f}\")\nprint(f\"Baseline RMSLE (median): {baseline_rmsle:.4f}\")\nprint(f\"Improvement:             {baseline_rmsle - rmsle:.4f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-06T17:08:59.836722Z","iopub.execute_input":"2026-07-06T17:08:59.836995Z","iopub.status.idle":"2026-07-06T17:09:00.141087Z","shell.execute_reply.started":"2026-07-06T17:08:59.836969Z","shell.execute_reply":"2026-07-06T17:09:00.139981Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# === CELL F: Submission ===\n\ntest_pred_log = model.predict(X_test)\ntest_pred     = np.clip(np.expm1(test_pred_log), 0, None)\n\nsubmission = pd.DataFrame({\n    'row_id': test_df['row_id'],\n    'kwh':    test_pred\n})\n\nsubmission.to_csv('su